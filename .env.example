# =============================================================================
# Lead Phone Collector — Environment Variables Template
# Copy file này thành .env và điền thông tin thực
# =============================================================================

# --- Google Sheets ---
# Tạo Service Account tại: https://console.cloud.google.com/
# Download JSON key -> đặt vào config/google-service-account.json
GOOGLE_SHEETS_CREDENTIALS_FILE=config/google-service-account.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Leads

# --- Facebook Graph API (tùy chọn) ---
# Chỉ cần nếu thu thập từ Facebook page do bạn quản lý
# Lấy token tại: https://developers.facebook.com/tools/explorer/
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# OAuth đăng nhập Web UI
# Đăng ký callback:
#   http://localhost:5000/auth/google/callback
#   http://localhost:5000/auth/facebook/callback
# Production phải dùng URL HTTPS công khai tương ứng.
APP_BASE_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Playwright Browser ---
# Chạy headless (ẩn cửa sổ browser): true/false
PLAYWRIGHT_HEADLESS=true
# Delay giữa các request (giây) để tránh bị block
PLAYWRIGHT_DELAY_MIN=1.5
PLAYWRIGHT_DELAY_MAX=3.5

# --- Database ---
DATABASE_PATH=data/leads.db
# Múi giờ Việt Nam (UTC+7)
APP_UTC_OFFSET_HOURS=7

# --- Flask ---
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_PORT=5000
FLASK_DEBUG=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/collector.log
