*$py.class
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.eggs/
htmlcov/
.coverage

# Virtual env
venv/
env/
.venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Selenium / ChromeDriver cache
.wdm/
chromedriver*
